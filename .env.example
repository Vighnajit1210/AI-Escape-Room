# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Google Gemini API key - create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (any text model from https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash

# V2 only: set to true to play without any API calls (rule-based parser + plain narration)
OFFLINE_MODE=false
